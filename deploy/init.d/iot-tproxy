#!/bin/sh /etc/rc.common
# TPROXY 策略路由：给被 nft `tproxy` 打上 mark 0x100 的 UDP 包一条投递路径
# （sing-box transparent-udp:12346）。缺少这两条时，包会被标记但无路可走而被丢弃。
#
# 与 deploy/nftables/31-gate-udp.nft 的 `meta mark set 0x100` /
# `tproxy ip to :12346` 配套；无 UDP 代理分流时可不用本文件。
#
# 幂等：start 前先 del，避免重复调用导致 rule 堆叠（实测踩过）。
START=18
STOP=10

start() {
	ip rule del fwmark 0x100 lookup 100 2>/dev/null
	ip rule add fwmark 0x100 lookup 100
	ip route replace local 0.0.0.0/0 dev lo table 100
}

stop() {
	ip rule del fwmark 0x100 lookup 100 2>/dev/null
	ip route del local 0.0.0.0/0 dev lo table 100 2>/dev/null
}

restart() {
	stop
	start
}
