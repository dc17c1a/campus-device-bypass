#!/bin/sh /etc/rc.common
# sing-box：下游代理核心（socks 入站 + 路由 + 出口组，示例见 deploy/sing-box/）。
# 二进制 /tmp/sing-box（tmpfs），种子 /usr/bin/sing-box.gz（overlay）：
# 开机 start 时若 /tmp 丢失则自动 gunzip 恢复，无需人工 scp。
# 配置 /etc/sing-box/config.json（先 check 后 run，非法配置拒绝启动）。
USE_PROCD=1
START=99
STOP=10
SEED=/usr/bin/sing-box.gz
BIN=/tmp/sing-box
start_service() {
  if [ ! -x $BIN ]; then
    [ -f $SEED ] || return 1
    gunzip -c $SEED > $BIN || return 1
    chmod 755 $BIN
  fi
  [ -f /etc/sing-box/config.json ] || return 1
  mkdir -p /tmp/wxdet
  $BIN check -c /etc/sing-box/config.json || return 1
  procd_open_instance sing-box
  procd_set_param command $BIN run -c /etc/sing-box/config.json
  # 小内存设备软上限（按设备内存调整）
  procd_set_param env GOGC=40 GOMEMLIMIT=33554432
  procd_set_param respawn 3600 5 0
  procd_set_param limits nofile="16384 16384"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
