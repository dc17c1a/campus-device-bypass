#!/bin/sh /etc/rc.common
# wxdet-gate —— 前置分流门（TCP :12347 + UDP :12348）
#
# nftables 把受管网段的 TCP 重定向进来（deploy/nftables/30-gate-redir.nft），
# STUN / UDP 80 / UDP 8080 经 DNAT 进 UDP 门（31-gate-udp.nft）。
# 本进程 peek 首包判路：命中私有协议指纹/明文特征的流量判 proxy，
# 拨到下游敏感/加密入口；其余判 pass，转交下游普通入口自行处理。
#
# 部署位置：/etc/init.d/wxdet-gate（chmod 755），二进制 /usr/bin/wxdet-gate。
# 启用：/etc/init.d/wxdet-gate enable && /etc/init.d/wxdet-gate start
USE_PROCD=1
START=94
STOP=06

start_service() {
	mkdir -p /tmp/wxdet
	procd_open_instance
	procd_set_param command /usr/bin/wxdet-gate
	# 小内存设备（如 256–512MB 级路由器）：软内存上限 + 更积极的 GC，
	# 防止 Go 运行时 RSS 冲高拖垮整机；数值可按设备内存调整。
	procd_set_param env GOGC=40 GOMEMLIMIT=16777216
	# respawn <阈值秒> <窗口秒> <重试次数>：崩溃自动拉起
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
