#!/bin/sh /etc/rc.common
# wxdet-gate —— 前置分流门（TCP :12347 + UDP :12348）
#
# nftables 把受管网段的 TCP 重定向进来（deploy/nftables/30-gate-redir.nft），
# 公网 UDP 全量经 TPROXY 进 UDP 门（31-gate-udp.nft；DNAT 已退役）。
# 本进程 peek 首包二判：标准 TLS/明文下载特征判 pass，转交下游普通入口；
# 其余一切判 proxy，进代理（fail-closed）。
#
# 部署位置：/etc/init.d/wxdet-gate（chmod 755），二进制 /usr/bin/wxdet-gate。
# 启用：/etc/init.d/wxdet-gate enable && /etc/init.d/wxdet-gate start
USE_PROCD=1
START=94
STOP=06

start_service() {
	mkdir -p /tmp/wxdet
	procd_open_instance
	procd_set_param command /usr/bin/wxdet-gate
	# EMFILE 防护：TCP 中继空闲 300s 收尾 + accept 退避（代码侧）；
	# procd 侧把 hard/soft 一起抬到 65535（gate 启动时另有自抬兜底）。
	procd_set_param limits nofile="65535 65535"
	# TCP 中继空闲超时（默认 300s，代码侧亦有默认值；此处显式声明防漂移）。
	procd_set_param env WD_TCP_IDLE_SEC=300
	# respawn <阈值秒> <窗口秒> <重试次数>：崩溃自动拉起
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
