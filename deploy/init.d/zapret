#!/bin/sh /etc/rc.common
# zapret：独立 desync（NFQUEUE，出口全 TCP，端口白名单在 nfqws 侧），脱离下游代理的 UA/指纹链。
# 二进制优先 /usr/bin/nfqws（overlay 常驻，重启自恢复），回退 /tmp/nfqws。
# 策略唯一来源 /etc/config/zapret（option nfqws_opt）；改参数只改 config。
# nft 表由 /etc/zapret.nft 恢复。注意：表文件不可放 /etc/nftables.d/ ——
# fw4 会把该目录 include 进 `table inet fw4` 上下文，嵌套 table 语法错误将
# 导致下次 fw4 启动失败。
USE_PROCD=1
START=98
STOP=11

# 隧道端点域名（启动时解析 A 记录补刷 nozapret 集；按你的环境替换）。
# 另建议 cron 每小时补刷一次（示例见 deploy/zapret/README.md）。
ZAPRET_DOMAINS="tunnel1.example.com tunnel2.example.com"

start_service() {
	nft list table inet zapret >/dev/null 2>&1 || nft -f /etc/zapret.nft || logger -t zapret "table restore from /etc/zapret.nft failed"
	# boot-time nozapret refresh：表恢复后后台补刷一次端点 IP；
	# 后台化（&）保证 boot 永不阻塞；无 sleep。
	{ for d in $ZAPRET_DOMAINS; do
		/usr/bin/drill "$d" @223.5.5.5 2>/dev/null | /usr/bin/awk '/^;; ANSWER/{f=1;next} /^;;/{f=0} f && $3=="IN" && $4=="A"{print $NF}' | while read -r ip; do
			[ -n "$ip" ] || continue
			nft add element inet zapret nozapret "{ $ip }" 2>/dev/null || logger -t zapret "boot nozapret add $ip failed"
		done
	done; } &
	NFQWS_BIN="/usr/bin/nfqws"
	[ -x "$NFQWS_BIN" ] || NFQWS_BIN="/tmp/nfqws"
	[ -x "$NFQWS_BIN" ] || {
		logger -t zapret "no nfqws binary (/usr/bin + /tmp both missing); nft table ensured, nfqws not started"
		return 0
	}
	config_load zapret
	config_get nfqws_opt main nfqws_opt
	[ -n "$nfqws_opt" ] || {
		logger -t zapret "/etc/config/zapret: option nfqws_opt empty; not starting"
		return 1
	}
	procd_open_instance zapret
	# shellcheck disable=SC2086: option 字符串故意做词拆分，还原多参数
	procd_set_param command $NFQWS_BIN $nfqws_opt
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
