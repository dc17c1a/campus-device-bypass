config main 'main'
	# nfqws 启动参数（示例档位，按需调优；须与 zapret.nft 的 qnum/fwmark 一致）。
	# 语义：80 端口伪造分片+切分（按方法切分，md5 签名伪装）；
	# 443 端口伪造乱序（中段切分，坏序列伪装）+ 小 TTL 探针。
	option nfqws_opt '--qnum=200 --dpi-desync-fwmark=0x40000000 --filter-tcp=80 --dpi-desync=fake,multisplit --dpi-desync-split-pos=2 --dpi-desync-fooling=md5sig --new --filter-tcp=443 --dpi-desync=fake,multidisorder --dpi-desync-split-pos=1 --dpi-desync-fooling=badseq --dpi-desync-autottl=2:4-10'
