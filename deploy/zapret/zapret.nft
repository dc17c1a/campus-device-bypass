# zapret 独立 desync 表（NFQUEUE，TCP 80/443）。
#
# 机制：出口 TCP 80/443 的前若干包 + 回包握手散件送 NFQUEUE，由 nfqws 做
# 伪造分片/乱序/坏序列脱敏（防 SNI 与明文特征识别）；已脱敏连接打内部标记，
# 后续包与豁免目的直接放行，established 后零开销。
#
# 部署位置：/etc/zapret.nft（注意：不可放 /etc/nftables.d/ —— fw4 会把该目录
# include 进 `table inet fw4` 上下文，嵌套 table 语法错误会导致 fw4 启动失败）。
# 恢复：nft -f /etc/zapret.nft（init 脚本负责，失败只记日志不阻断启动）。
#
# 脱敏说明：nozapret 填自家隧道端点 IP（本机发出的加密隧道流量不能被 fake 包
# 搞坏）；豁免端口按你的管理/隧道端口填；qnum/fwmark/包数档位为示例值，
# 须与 /etc/config/zapret 的 nfqws_opt 保持一致。
table inet zapret {
	set nozapret {
		type ipv4_addr
		flags interval
		# 自家隧道端点 IP（静态填这里；动态端点由 init 脚本补刷）
	}

	chain postnat_hook {
		type filter hook postrouting priority srcnat + 1; policy accept;
		# 管理/SSH 与自家隧道端口直接放行
		oifname "br-lan" tcp dport { 22 } return
		# 隧道端点豁免 desync
		ip daddr @nozapret return
		# 出向 80/443 仅前若干包进队（conntrack 计数）
		oifname "br-lan" meta mark & 0x40000000 == 0x00000000 tcp dport { 80, 443 } ct original packets 0-6 queue flags bypass to 200
		# 已打标连接记 ct mark，后续包免二次改写
		meta mark & 0x40000000 != 0x00000000 ct mark set ct mark | 0x40000000
	}

	chain pre {
		type filter hook prerouting priority filter; policy accept;
		# 隧道端点回包豁免
		ip saddr @nozapret return
		# 回程 80/443：前若干包 + 握手/结束散件进队（双向 desync 才生效）
		iifname "br-lan" tcp sport { 80, 443 } ct reply packets 0-3 queue flags bypass to 200
		iifname "br-lan" tcp sport { 80, 443 } tcp flags syn,ack queue flags bypass to 200
		iifname "br-lan" tcp sport { 80, 443 } tcp flags fin,rst queue flags bypass to 200
		# autottl 探针副作用：带标连接的 time-exceeded 回包直接丢弃
		iifname "br-lan" icmp type time-exceeded ct mark & 0x40000000 != 0x00000000 drop
	}

	chain predefrag {
		type filter hook output priority -401; policy accept;
		# 带标包免 conntrack 跟踪（防 fake 包污染连接状态）
		meta mark & 0x40000000 != 0x00000000 notrack
	}
}
